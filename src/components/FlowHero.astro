---
/**
 * Hero with a live "wind tunnel" smoke visualisation.
 * A smoke rake on the left releases filaments that are advected by the
 * potential flow around an invisible cylinder following the pointer
 *   u = U (1 - R²(x² - y²)/r⁴),   v = -2 U R² x y / r⁴
 * plus a divergence-free (curl-noise) perturbation that grows in the wake.
 */
---

<section class="hero">
  <canvas id="flow" aria-hidden="true"></canvas>
  <div class="hero-content wrap">
    <p class="eyebrow">CFD · Numerical methods · HPC</p>
    <h1 class="title">
      <span class="line">Matteo</span>
      <span class="line accent">Barbieri</span>
    </h1>
    <p class="lead">
      MSc Aeronautical Engineering @ Politecnico di Milano. I build and optimise simulation
      pipelines, from OpenFOAM internals to neural operators.
    </p>
    <a href="#index" class="cta">Explore the work <span>↓</span></a>
  </div>
  <p class="caption">smoke visualisation · potential flow + turbulent wake · move the pointer</p>
</section>

<script>
  type P = { x: number; y: number; age: number; life: number; seed: number };

  let stop: (() => void) | null = null;

  /** Soft radial "puff" sprite in the accent colour, drawn once and reused. */
  function makePuff(rgb: string, size = 64) {
    const c = document.createElement('canvas');
    c.width = c.height = size;
    const g = c.getContext('2d')!;
    const grad = g.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
    grad.addColorStop(0, `rgba(${rgb},0.55)`);
    grad.addColorStop(0.35, `rgba(${rgb},0.22)`);
    grad.addColorStop(1, `rgba(${rgb},0)`);
    g.fillStyle = grad;
    g.fillRect(0, 0, size, size);
    return c;
  }

  function init() {
    stop?.();
    const canvas = document.getElementById('flow') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent-rgb').trim() || '255,122,26';
    const hot = makePuff(accent);
    const cool = makePuff('255,160,90');

    let w = 0, h = 0, dpr = 1;
    const U = 1.3;
    let R = 60;
    let rake: number[] = [];
    const c = { x: 0, y: 0 }, target = { x: 0, y: 0 };
    let parts: P[] = [];
    let t = 0;

    function spawn(): P {
      const y0 = rake[(Math.random() * rake.length) | 0] + (Math.random() - 0.5) * 2;
      return { x: -Math.random() * 6, y: y0, age: 0, life: 500 + Math.random() * 400, seed: Math.random() * 1000 };
    }

    function resize() {
      dpr = Math.min(devicePixelRatio || 1, 2);
      w = canvas!.clientWidth;
      h = canvas!.clientHeight;
      canvas!.width = w * dpr;
      canvas!.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      R = Math.max(45, Math.min(w, h) * 0.085);
      target.x = c.x = w * 0.66;
      target.y = c.y = h * 0.5;
      // smoke rake: evenly spaced nozzles
      const gap = Math.max(22, h / 30);
      rake = Array.from({ length: Math.floor(h / gap) }, (_, i) => (i + 0.5) * gap);
      parts = Array.from({ length: Math.min(4000, Math.round((w * h) / 380)) }, () => {
        const p = spawn();
        p.age = Math.random() * p.life; // pre-age so the screen starts filled
        p.x = Math.random() * w;
        return p;
      });
      ctx.clearRect(0, 0, w, h);
      if (reduce) for (let i = 0; i < 260; i++) frame();
    }

    /** potential flow around the (invisible) cylinder */
    function potential(x: number, y: number) {
      const dx = x - c.x, dy = y - c.y;
      let r2 = dx * dx + dy * dy;
      const R2 = R * R;
      if (r2 < R2) r2 = R2; // particles never sit inside the body
      const r4 = r2 * r2;
      return { u: U * (1 - (R2 * (dx * dx - dy * dy)) / r4), v: (-2 * U * R2 * dx * dy) / r4 };
    }

    /** divergence-free noise: velocity = curl of a smooth stream function ψ */
    function curl(x: number, y: number, s: number) {
      const k1 = 0.012, k2 = 0.027, w1 = 0.011, w2 = 0.019;
      // ψ = sin(k1 x - w1 t) cos(k1 y + s) + 0.5 sin(k2 y + w2 t) cos(k2 x)
      const a = k1 * x - w1 * t, b = k1 * y + s, cc = k2 * y + w2 * t, d = k2 * x;
      const dpsi_dy = -k1 * Math.sin(a) * Math.sin(b) + 0.5 * k2 * Math.cos(cc) * Math.cos(d);
      const dpsi_dx = k1 * Math.cos(a) * Math.cos(b) - 0.5 * k2 * Math.sin(cc) * Math.sin(d);
      return { u: dpsi_dy, v: -dpsi_dx };
    }

    let raf = 0, running = !reduce;
    function frame() {
      t++;
      // slow fade -> long, soft smoke trails
      // (fade the canvas *alpha*: the page background shows through, so no
      // colour drift from 8-bit rounding of repeated blends)
      ctx.globalCompositeOperation = 'destination-out';
      ctx.fillStyle = 'rgba(0, 0, 0, 0.04)';
      ctx.fillRect(0, 0, w, h);
      ctx.globalCompositeOperation = 'lighter';

      c.x += (target.x - c.x) * 0.04;
      c.y += (target.y - c.y) * 0.04;

      for (const p of parts) {
        if (p.x > w + 30 || p.y < -30 || p.y > h + 30 || p.age > p.life) {
          Object.assign(p, spawn());
        }
        const v = potential(p.x, p.y);
        // turbulence: weak everywhere, strong in the wake behind the body
        const behind = p.x - c.x;
        const wake =
          behind > 0 ? Math.exp(-((p.y - c.y) ** 2) / (2 * (R * 1.6 + behind * 0.25) ** 2)) * Math.min(1, behind / (R * 1.5)) : 0;
        const n = curl(p.x, p.y, p.seed * 0.002);
        const amp = 3 + 95 * wake;
        const du = v.u + n.u * amp, dv = v.v + n.v * amp;
        p.x += du * 1.4;
        p.y += dv * 1.4;
        // smoke that slows down (stagnation region) or drifts into the body would
        // pile up into a bright blob: let it dissipate quickly there instead
        const inBody = (p.x - c.x) ** 2 + (p.y - c.y) ** 2 < R * R;
        p.age += inBody ? p.life : Math.hypot(du, dv) < 0.45 * U ? 10 : 1;

        const lifeT = p.age / p.life;
        const fadeIn = Math.min(1, p.age / 30);
        const alpha = fadeIn * (1 - lifeT) * (0.22 + 0.18 * wake);
        if (alpha < 0.01) continue;
        const size = 3 + lifeT * 16 + wake * 12; // smoke diffuses as it ages
        ctx.globalAlpha = alpha;
        ctx.drawImage(lifeT < 0.5 ? hot : cool, p.x - size / 2, p.y - size / 2, size, size);
      }
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';

      if (running) raf = requestAnimationFrame(frame);
    }

    function onMove(e: PointerEvent) {
      const rect = canvas!.getBoundingClientRect();
      if (e.clientY > rect.bottom) return;
      target.x = e.clientX - rect.left;
      target.y = e.clientY - rect.top;
    }

    // pause when the hero scrolls out of view
    const io = new IntersectionObserver(([e]) => {
      if (reduce) return;
      if (e.isIntersecting && !running) {
        running = true;
        raf = requestAnimationFrame(frame);
      } else if (!e.isIntersecting) {
        running = false;
        cancelAnimationFrame(raf);
      }
    });

    addEventListener('resize', resize);
    addEventListener('pointermove', onMove);
    io.observe(canvas);
    resize();
    if (!reduce) raf = requestAnimationFrame(frame);

    stop = () => {
      running = false;
      cancelAnimationFrame(raf);
      removeEventListener('resize', resize);
      removeEventListener('pointermove', onMove);
      io.disconnect();
    };
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => stop?.());
</script>

<style>
  .hero {
    position: relative;
    background: var(--bg);
    height: calc(100svh - 3.5rem);
    min-height: 520px;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  canvas {
    /* screen blend: leftover dark pixels from the alpha fade can never darken the page */
    mix-blend-mode: screen;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    pointer-events: none;
  }
  .hero-content a {
    pointer-events: auto;
  }
  .eyebrow {
    color: var(--accent);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1.2rem;
    animation: rise 0.9s var(--ease) both;
  }
  .title {
    font-size: clamp(3rem, 9vw, 7.5rem);
    line-height: 0.95;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .line {
    display: block;
    animation: rise 1s var(--ease) both;
  }
  .line:nth-child(2) {
    animation-delay: 0.12s;
  }
  .accent {
    color: transparent;
    -webkit-text-stroke: 1px var(--fg);
  }
  .lead {
    max-width: 34rem;
    margin-top: 1.8rem;
    color: var(--fg-muted);
    animation: rise 1s 0.25s var(--ease) both;
  }
  .cta {
    margin-top: 2.2rem;
    align-self: flex-start;
    text-decoration: none;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 60%, transparent);
    backdrop-filter: blur(6px);
    padding: 0.7rem 1.2rem;
    border-radius: 999px;
    font-size: 0.9rem;
    transition:
      border-color 0.3s,
      color 0.3s;
    animation: rise 1s 0.4s var(--ease) both;
  }
  .cta:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .cta span {
    display: inline-block;
    animation: bob 2s ease-in-out infinite;
  }
  .caption {
    position: absolute;
    bottom: 1rem;
    right: 1.5rem;
    font-size: 0.7rem;
    color: var(--fg-muted);
    opacity: 0.7;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  @keyframes bob {
    50% {
      transform: translateY(3px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .eyebrow,
    .line,
    .lead,
    .cta,
    .cta span {
      animation: none;
    }
  }
</style>
